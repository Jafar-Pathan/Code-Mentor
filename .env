# ═══════════════════════════════════════════════════════════════
# Neon PostgreSQL — Get your connection strings at:
#   https://console.neon.tech → your project → Connection Details
# ═══════════════════════════════════════════════════════════════
#
# Pooled connection (via Neon proxy) — used at runtime for queries.
# Has "-pooler" in the hostname. Supports thousands of concurrent connections.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
#
# Direct connection — used ONLY for migrations (db push / db migrate).
# NO "-pooler" in hostname. Needed for schema DDL operations.
DIRECT_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require