generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  avatar       String?
  role         String   @default("student")
  level        String   @default("beginner")
  streak       Int      @default(0)
  xp           Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSessions      ChatSession[]
  quizAttempts      QuizAttempt[]
  interviewSessions InterviewSession[]
  codeReviews       CodeReview[]
  learningProgress  LearningProgress[]
  documents         Document[]

  @@index([email])
  @@index([level])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Conversation")
  topic     String?
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String
  content    String
  sources    String?
  createdAt  DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  difficulty  String   @default("medium")
  questions   String   // JSON array of questions
  timeLimit   Int      @default(300)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts QuizAttempt[]

  @@index([category])
  @@index([difficulty])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  total     Int
  answers   String   // JSON
  timeTaken Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@index([userId])
  @@index([quizId])
  @@index([createdAt])
}

model InterviewSession {
  id          String   @id @default(cuid())
  userId      String
  type        String   @default("coding")
  topic       String?
  questions   String   // JSON
  answers     String   // JSON
  score       Int?
  feedback    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
}

model CodeReview {
  id           String   @id @default(cuid())
  userId       String
  language     String
  code         String
  reviewResult String   // JSON
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([language])
  @@index([createdAt])
}

model LearningProgress {
  id          String   @id @default(cuid())
  userId      String
  topic       String
  subtopic    String?
  mastery     Int      @default(0)
  totalQuizzes Int     @default(0)
  totalTime   Int      @default(0)
  lastStudied DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([topic])
  @@index([mastery])
  @@index([userId, topic])
}

// ─── RAG: Knowledge Base ────────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  userId      String
  title       String
  fileName    String
  fileType    String   @default("txt")      // txt, md, json, csv
  chunkCount  Int      @default(0)
  totalChars  Int      @default(0)
  chunks      DocumentChunk[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String                        // The actual text chunk
  chunkIndex Int                           // Order within the document
  charStart  Int                           // Character offset in original
  charEnd    Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
  @@index([documentId, chunkIndex])
}

model Topic {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String
  description   String?
  order         Int      @default(0)
  difficulty    String   @default("beginner")
  prerequisites String?
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([difficulty])
  @@index([order])
}